<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.flowwrite.ai">

    <!-- Microphone permission for voice dictation (Requested at runtime in MainActivity) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      PRIVACY & OFFLINE ARCHITECTURE NOTE:
      FlowWrite AI deliberately omits android.permission.INTERNET.
      All LLM inference (Qwen2.5-0.5B-Instruct-Q4_K_M via llama.cpp) and Room SQLite
      personalization run strictly in app-private storage without network sockets.
    -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Onboarding, Model Import (SAF), Personalization, Dictionary & Settings Activity -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Custom Android Voice InputMethodService -->
        <service
            android:name=".keyboard.FlowWriteKeyboardService"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
